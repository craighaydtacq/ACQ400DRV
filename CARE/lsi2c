# list all i2c devices

get_names() {
	bus=$1
	dev=$2
	echo bus:$bus dev:$dev $(cat /sys/bus/i2c/devices/$bus/$dev/name)
}

for bus in $(ls /sys/bus/i2c/devices/ | grep i2c | sort -n -t- -k2); do echo $bus $(ls /sys/bus/i2c/devices/$bus/ | grep ${bus#*-}-0); done
for bus in $(ls /sys/bus/i2c/devices/ | grep i2c | sort -n -t- -k2); do for dev in $(ls /sys/bus/i2c/devices/$bus/ | grep ${bus#*-}-0); do get_names $bus $dev; done; done

